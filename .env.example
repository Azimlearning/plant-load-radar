# Copy to .env and fill in. Never commit .env.
# Every variable and where to get it: refdocs/guides/env_setup.md

# LLM provider key for the model layer (ASSUMED provider: Anthropic — see DECISIONS.md D-08).
# Server-side only. Not needed unless PLR_LLM_MODE is live or record.
ANTHROPIC_API_KEY=

# Model layer: off (default) | live | record | replay
PLR_LLM_MODE=
PLR_LLM_MODEL=
# Most model calls one server run may make (cost brake; default 60)
PLR_LLM_MAX_CALLS=
# Where record saves and replay reads model answers (default .llm/recordings.json, gitignored)
PLR_LLM_RECORDINGS=

# Data and ledger
PLR_DATA_DIR=
# file | cookie (default: cookie on Vercel, file elsewhere)
PLR_LEDGER_MODE=
# Default .ledger/ledger.jsonl (gitignored)
PLR_LEDGER_PATH=
